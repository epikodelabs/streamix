    "./projects/libraries/streamix/vue/vite/src",
    "./projects/libraries/streamix/vue/editor/src"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/env.spec.ts",
    "**/src/tests/_skipped/**"
  ],
  "preserveOutputs": false,
  "outDir": "dist/.vite-jasmine-build-node",
  "browser": "node",
  "headless": true,
  "viteBuildOptions": {
    "target": "es2022",
    "sourcemap": true,
    "minify": false,
    "preserveModules": false,
    "preserveModulesRoot": "."
  },
  "htmlOptions": {
    "title": "Jasmine Test Runner (Node)",
    "preludeModules": [
      "@angular/compiler"
    ]
  },
  "jasmineConfig": {
    "env": {
      "stopSpecOnExpectationFailure": false,
      "random": false,
      "timeout": 120000
    }
  }
}
