  "testDirs": [
    "./projects/libraries/streamix/angular/src/tests/ssr",
    "./projects/libraries/streamix/angular/editor/src",
    "./projects/libraries/streamix/react/compiler/src",
    "./projects/libraries/streamix/react/vite/src",
