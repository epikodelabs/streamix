{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "allowJs": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist/streamix",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "importHelpers": true,
    "target": "ESNext",
    "module": "ESNext",
    "useDefineForClassFields": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext",
      "dom",
      "dom.iterable"
    ],
    "paths": {
      "@epikodelabs/streamix/aggregates": [
        "./projects/libraries/streamix/aggregates/src/lib/index.ts"
      ],
      "@epikodelabs/streamix/compiler": [
        "./projects/libraries/streamix/compiler/src/public-api.ts"
      ],
      "@epikodelabs/streamix/dom": [
        "./projects/libraries/streamix/dom/src/lib/index.ts"
      ],
      "@epikodelabs/streamix/networking": [
        "./projects/libraries/streamix/networking/src/lib/index.ts"
      ],
      "@epikodelabs/streamix/angular/builder": [
        "./projects/libraries/streamix/angular/builder/src/public-api.ts"
      ],
      "@epikodelabs/streamix/angular/compiler": [
        "./projects/libraries/streamix/angular/compiler/src/public-api.ts"
      ],
      "@epikodelabs/streamix/angular/editor": [
        "./projects/libraries/streamix/angular/editor/src/public-api.ts"
      ],
      "@epikodelabs/streamix/angular": [
        "./projects/libraries/streamix/angular/src/lib/index.ts"
      ],
      "@epikodelabs/streamix/react/compiler": [
        "./projects/libraries/streamix/react/compiler/src/public-api.ts"
      ],
      "@epikodelabs/streamix/react/builder": [
        "./projects/libraries/streamix/react/builder/src/public-api.ts"
      ],
      "@epikodelabs/streamix/react/editor": [
        "./projects/libraries/streamix/react/editor/src/public-api.ts"
      ],
      "@epikodelabs/streamix/react/vite": [
        "./projects/libraries/streamix/react/vite/src/public-api.ts"
      ],
      "@epikodelabs/streamix/react": [
        "./projects/libraries/streamix/react/src/public-api.ts"
      ],
      "@epikodelabs/streamix/vue/compiler": [
        "./projects/libraries/streamix/vue/compiler/src/public-api.ts"
      ],
      "@epikodelabs/streamix/vue/builder": [
        "./projects/libraries/streamix/vue/builder/src/public-api.ts"
      ],
      "@epikodelabs/streamix/vue/vite": [
        "./projects/libraries/streamix/vue/vite/src/public-api.ts"
      ],
      "@epikodelabs/streamix/vue/editor": [
        "./projects/libraries/streamix/vue/editor/src/public-api.ts"
      ],
      "@epikodelabs/streamix/vue": [
        "./projects/libraries/streamix/vue/src/lib/index.ts"
      ],
      "@epikodelabs/streamix/introspection": [
        "./projects/libraries/streamix/introspection/src/lib/index.ts"
      ],
      "@epikodelabs/streamix": [
        "./projects/libraries/streamix/src/lib/index.ts"
      ]
    },
    "types": [
      "@webgpu/types",
      "jasmine",
      "node"
    ]
  },
  "exclude": [
    "dist",
    "node_modules"
  ],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}
