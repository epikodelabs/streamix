{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "app1": {
      "projectType": "application",
      "root": "projects/apps/app1",
      "sourceRoot": "projects/apps/app1/src",
      "architect": {
        "application": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/apps/app1",
            "index": "projects/apps/app1/src/index.html",
            "browser": "projects/apps/app1/src/main.ts",
            "polyfills": [],
            "tsConfig": ".angular/.streamix/app1/tsconfig.app.json",
            "fileReplacements": [
              {
                "replace": "projects/apps/app1/src/main.ts",
                "with": ".angular/.streamix/app1/src/main.ts"
              }
            ],
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/apps/app1/public"
              }
            ],
            "styles": [
              "projects/apps/app1/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "build": {
          "builder": "@epikodelabs/streamix/angular/builder:application",
          "options": {
            "delegateTarget": "app1:application",
            "sourceRoot": "projects/apps/app1/src"
          },
          "configurations": {
            "production": {},
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@epikodelabs/streamix/angular/builder:application",
          "options": {
            "delegateTarget": "app1:dev-server",
            "sourceRoot": "projects/apps/app1/src",
            "introspection": true
          },
          "configurations": {
            "production": {},
            "development": {}
          },
          "defaultConfiguration": "development"
        },
        "dev-server": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "app1:application:production" },
            "development": { "buildTarget": "app1:application:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    },
