{
  "name": "@epikodelabs/streamix",
  "version": "2.0.47",
  "description": "Reactive TypeScript library",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "RxJS-inspired",
    "reactive programming",
    "data streams"
  ],
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "main": "public-api.ts",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://epikodelabs.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/epikodelabs/epikodelabs.github.io"
  },
  "author": "Oleksii Shepel",
  "email": "oleksii.shepel@outlook.com",
  "module": "fesm2022/epikodelabs-streamix.mjs",
  "typings": "types/epikodelabs-streamix.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/epikodelabs-streamix.d.ts",
      "default": "./fesm2022/epikodelabs-streamix.mjs"
    },
    "./aggregates": {
      "types": "./types/epikodelabs-streamix-aggregates.d.ts",
      "default": "./fesm2022/epikodelabs-streamix-aggregates.mjs"
    },
    "./coroutines": {
      "types": "./types/epikodelabs-streamix-coroutines.d.ts",
      "default": "./fesm2022/epikodelabs-streamix-coroutines.mjs"
    },
    "./dom": {
      "types": "./types/epikodelabs-streamix-dom.d.ts",
      "default": "./fesm2022/epikodelabs-streamix-dom.mjs"
    },
    "./networking": {
      "types": "./types/epikodelabs-streamix-networking.d.ts",
      "default": "./fesm2022/epikodelabs-streamix-networking.mjs"
    }
  }
}