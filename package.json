{
  "name": "streamix",
  "version": "3.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "testify --headless --browser chrome",
    "test:watch": "testify --browser chrome",
    "watch": "ng build --watch --configuration development",
    "jasmine": "testify --headless --browser chrome",
    "jasmine:coverage": "testify --headless --browser chrome --coverage",
    "minify": "node terser.mjs && npx typegen",
    "lint": "eslint --config eslint.config.js",
    "lint:fix": "eslint --config eslint.config.js --fix",
    "clean": "npm run lint:fix",
    "pack:check": "npm pack ./dist/streamix --dry-run",
    "docs:generate": "node scripts/copy-vitepress-config.mjs && typedoc --plugin typedoc-plugin-markdown --out dist/api",
    "docs:prepare": "node scripts/docs-prepare.mjs",
    "docs:fix-api-links": "node scripts/fix-typedoc-links.mjs",
    "docs:seo": "node scripts/add-seo-metadata.mjs",
    "docs:build": "npm run docs:prepare && npm run docs:generate && npm run docs:fix-api-links && npm run docs:seo && vitepress build dist && npm run docs:rewrite",
    "docs:rewrite": "node scripts/rewrite-vitepress-base.mjs"
  },
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@types/three": "^0.185.1",
    "blockdom": "0.9.29",
    "fflate": "^0.8.3",
    "million": "3.1.11",
    "three": "^0.185.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@epikodelabs/testify": "^1.0.35",
    "@epikodelabs/typegen": "^1.0.13",
    "@types/jasmine": "^6.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-glob": "^3.3.3",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.9.6",
    "rollup": "^4.62.3",
    "strip-json-comments": "^5.0.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4"
  },
  "type": "module",
  "sideEffects": false,
  "overrides": {
    "shell-quote": "^1.8.4"
  }
}
