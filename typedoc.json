{
  "entryPoints": [
    "projects/libraries/streamix/src/public-api.ts",
    "projects/libraries/streamix/aggregates/src/public-api.ts",
    "projects/libraries/streamix/coroutines/src/public-api.ts",
    "projects/libraries/streamix/dom/src/public-api.ts",
    "projects/libraries/streamix/networking/src/public-api.ts"
  ],
  "tsconfig": "typedoc.tsconfig.json",
  "out": "docs/api",
  "gitRemote": "origin",
  "gitRevision": "main",
  "sourceLinkTemplate": "https://github.com/epikodelabs/streamix/blob/{gitRevision}/{path}#L{line}", 
  "plugin": ["typedoc-plugin-markdown"],
  "theme": "markdown",
  "hideGenerator": true,
  "skipErrorChecking": false,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "entryPointStrategy": "resolve",
  "readme": "none",
  "externalSymbolLinkMappings": {
    "typescript": {
      "ArrayBuffer": "#",
      "AbortSignal": "#",
      "AsyncIterable": "#",
      "Blob": "#",
      "Iterable": "#",
      "Response": "#",
      "Uint8Array": "#"
    }
  },
  "intentionallyNotExported": [
    "Actor",
    "DefinedValue",
    "FormulaContext",
    "Method",
    "Coroutine",
    "CoroutineDefinitionRest",
    "ScopeOf",
    "TaskRunner",
    "UnwrapSnapshotValues",
    "WithLatestInput",
    "AtomNode",
    "ForkHandlerResult",
    "Observer",
    "WorkerUtilsCompatibility"
  ],
  "sort": ["source-order"],
  "kindSortOrder": [
    "Document",
    "Project",
    "Module",
    "Namespace",
    "Enum",
    "EnumMember",
    "Class",
    "Interface",
    "TypeAlias",
    "Constructor",
    "Property",
    "Variable",
    "Function",
    "Method",
    "Accessor",
    "Parameter",
    "TypeParameter",
    "TypeLiteral",
    "CallSignature",
    "ConstructorSignature",
    "IndexSignature",
    "GetSignature",
    "SetSignature"
  ],
  "categorizeByGroup": false,
  "defaultCategory": "Other",
  "categoryOrder": [
    "Classes",
    "Interfaces",
    "Types",
    "Functions",
    "Variables",
    "*"
  ]
}


