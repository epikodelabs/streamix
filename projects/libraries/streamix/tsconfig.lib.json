{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/streamix",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@epikodelabs/streamix/aggregates": [
        "./aggregates/src/lib/index.ts"
      ],
      "@epikodelabs/streamix/dom": [
        "./dom/src/lib/index.ts"
      ],
      "@epikodelabs/streamix/networking": [
        "./networking/src/lib/index.ts"
      ],
      "@epikodelabs/streamix": [
        "./src/lib/index.ts"
      ],
      "@epikodelabs/streamix/angular": [
        "./angular/src/lib/index.ts"
      ],
      "@epikodelabs/streamix/angular/compiler": [
        "./angular/compiler/src/public-api.ts"
      ],
      "@epikodelabs/streamix/vue": [
        "./vue/src/public-api.ts"
      ],
      "@epikodelabs/streamix/vue/compiler": [
        "./vue/compiler/src/public-api.ts"
      ],
      "@epikodelabs/streamix/vue/builder": [
        "./vue/builder/src/public-api.ts"
      ],
      "@epikodelabs/streamix/vue/vite": [
        "./vue/vite/src/public-api.ts"
      ]
    }
  },
  "files": [
    "src/public-api.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
