{
  "extends": "../../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/app",
    "types": [
      "vite/client",
      "node"
    ],
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "files": [
    "main.ts"
  ],
  "include": [
    "**/*.ts",
    "**/*.vue"
  ],
  "vueCompilerOptions": {
    "plugins": [
      "@epikodelabs/streamix/vue/editor/tsserver"
    ]
  }
}
